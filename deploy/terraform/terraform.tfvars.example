# Copy to terraform.tfvars (ignored by git) and fill in.
# Pass the API token via the environment instead: export TF_VAR_hcloud_token=...

ssh_public_key    = "ssh-ed25519 AAAA... you@laptop"
ssh_allowed_cidrs = ["203.0.113.10/32"]
repo_url          = "https://github.com/amlaban65/uptime-monitor.git"

